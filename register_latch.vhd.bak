LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY latch IS
    PORT (
        A      : IN  STD_LOGIC_VECTOR(7 DOWNTO 0);
        resetn : IN  STD_LOGIC;
        clock  : IN  STD_LOGIC;
        Q      : OUT STD_LOGIC_VECTOR(7 DOWNTO 0)
    );
END latch;

ARCHITECTURE Behaviour OF latch IS
BEGIN

    PROCESS (resetn, clock)
    BEGIN
        IF resetn = '0' THEN
            Q <= (others => '0');

        ELSIF rising_edge(clock) THEN
            Q <= A;

        END IF;
    END PROCESS;

END Behaviour;